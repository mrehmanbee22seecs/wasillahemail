rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }
    // Only admins or the project owner can link an event to a project
    function canLinkEventToProject(projectId) {
      let proj = get(/databases/$(database)/documents/project_submissions/$(projectId)).data;
      return isAdmin() || (
        isAuthenticated() && proj != null && proj.submittedBy == request.auth.uid
      );
    }

    // === CHATBOT AND SUPPORTING COLLECTIONS ===

    // Knowledge Base - Public read, admin write
    match /kb/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Unanswered queries - public create, admin manage
    match /unanswered_queries/{queryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin notifications - admin manage; allow create from clients
    match /admin_notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // === EXISTING RULES ===
    
    match /users/{userId} {
      // Allow public read of NGO profiles that are explicitly public, otherwise require auth
      allow read: if (resource.data.profileVisibility == 'public')
                  || isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwnerOrAdmin(userId);
      allow delete: if isAdmin();
    }

    match /project_submissions/{submissionId} {
      // Anyone can read approved + visible submissions; owners and admins can read theirs
      allow read: if (resource.data.status == 'approved' && resource.data.isVisible == true)
                  || (isAuthenticated() && request.auth.uid == resource.data.submittedBy)
                  || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.submittedBy || isAdmin());
      
      // Subcollection for project applications
      match /applications/{applicationId} {
        allow read: if isAuthenticated() && 
          (request.auth.uid == get(/databases/$(database)/documents/project_submissions/$(submissionId)).data.submittedBy || isAdmin());
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /event_submissions/{submissionId} {
      allow read: if (resource.data.status == 'approved' && resource.data.isVisible == true)
                  || (isAuthenticated() && request.auth.uid == resource.data.submittedBy)
                  || isAdmin();
      // Create allowed for authenticated users, but if linking to a project,
      // only admins or that project's owner may do so
      allow create: if isAuthenticated() && (
        // If no projectId provided, allow create
        !request.resource.data.keys().hasAny(['projectId']) ||
        // Empty projectId treated as not linking
        request.resource.data.projectId == '' ||
        // When linking, enforce permission
        canLinkEventToProject(request.resource.data.projectId)
      );
      // Updates/deletes allowed to submitter or admin, but changing/setting projectId
      // must satisfy the same project-link permission
      allow update, delete: if isAuthenticated() && (
        (request.auth.uid == resource.data.submittedBy || isAdmin())
      ) && (
        // If projectId unchanged or not provided, ok; else must be allowed to link
        !request.resource.data.keys().hasAny(['projectId']) ||
        request.resource.data.projectId == resource.data.projectId ||
        request.resource.data.projectId == '' ||
        canLinkEventToProject(request.resource.data.projectId)
      );
      
      // Subcollection for event registrations
      match /registrations/{registrationId} {
        allow read: if isAuthenticated() && 
          (request.auth.uid == get(/databases/$(database)/documents/event_submissions/$(submissionId)).data.submittedBy || isAdmin());
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /hero_content/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /programs/{programId} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{testimonialId} { allow read: if true; allow write: if isAdmin(); }
    match /leaders/{leaderId} { allow read: if true; allow write: if isAdmin(); }
    match /project_leaders/{leaderId} { allow read: if true; allow write: if isAdmin(); }
    match /event_organizers/{organizerId} { allow read: if true; allow write: if isAdmin(); }
    match /editableContent/{docId} { allow read: if true; allow write: if isAdmin(); }

    match /volunteer_applications/{applicationId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.submittedBy || isAdmin());
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // System docs (e.g., health checks, KB updates log)
    match /system/{docId} {
      allow read: if true;
      // Allow authenticated writes for health checks; tighten if needed
      allow write: if isAuthenticated();
    }

    match /content/{contentId} { allow read: if true; allow write: if isAdmin(); }
    match /page_content/{pageId} { allow read: if true; allow write: if isAdmin(); }

    match /users/{userId}/chats/{chatId} {
      // Support chat threads; owner or admin can access
      allow read, write: if isOwnerOrAdmin(userId);
    }

    match /users/{userId}/chats/{chatId}/messages/{messageId} {
      allow read, write: if isOwnerOrAdmin(userId);
    }

    // Project-based chat rooms
    match /project_chats/{projectId}/messages/{messageId} {
      // Any authenticated user can read/write project chat messages;
      // moderation is handled by admins in UI
      allow read, create: if isAuthenticated();
      // Only admins can update/delete messages (moderation)
      allow update, delete: if isAdmin();
    }

    match /project_chats/{projectId}/typing/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // === NOTIFICATIONS COLLECTION ===
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
      // System can create notifications for users, users can't create their own
      allow create: if isAuthenticated();
      // Users can update/delete their own notifications
      allow update, delete: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
    }

    // === NOTIFICATION PREFERENCES COLLECTION ===
    match /notification_preferences/{userId} {
      // Users can read/update their own preferences
      allow read, write: if isAuthenticated() && 
        request.auth.uid == userId;
      // Admins can read all preferences
      allow read: if isAdmin();
    }

    // === PUSH NOTIFICATION TOKENS COLLECTION ===
    match /push_notification_tokens/{tokenId} {
      // Users can read/update their own tokens
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      // Users can create tokens for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }

    // === REMINDERS COLLECTION ===
    match /reminders/{reminderId} {
      // Users can read their own reminders, admins can read all
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      // Authenticated users can create reminders
      allow create: if isAuthenticated();
      // Users can update/delete their own reminders, admins can update/delete any
      allow update, delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // === USER TASKS COLLECTION (for dashboards) ===
    match /user_tasks/{taskId} {
      // Users can read their own tasks, admins can read all
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      // Users can create their own tasks
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      // Users can update/delete their own tasks, admins can update/delete any
      allow update, delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // === USER NOTES COLLECTION (for dashboards) ===
    match /user_notes/{noteId} {
      // Users can read their own notes, admins can read all
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      // Users can create their own notes
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      // Users can update/delete their own notes, admins can update/delete any
      allow update, delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // === APPLICATIONS, REGISTRATIONS, NEWSLETTER, EVENTS ===
    match /project_applications/{id} {
      allow create: if true;
      // Users can read their own applications, admins can read all
      allow read: if isAuthenticated() && 
        (request.auth.token.email == resource.data.email || isAdmin());
      // Only admins can update (for edit approval workflow)
      allow update, delete: if isAdmin();
    }

    match /event_registrations/{id} {
      allow create: if true;
      // Users can read their own registrations, admins can read all
      allow read: if isAuthenticated() && 
        (request.auth.token.email == resource.data.email || isAdmin());
      // Only admins can update (for edit approval workflow)
      allow update, delete: if isAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // === EDIT REQUEST COLLECTIONS ===
    // Project Edit Requests (for editing published projects)
    match /project_edit_requests/{requestId} {
      // Users can create edit requests for their own projects
      allow create: if isAuthenticated() && 
                       request.resource.data.requestedBy == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      // Users can read their own edit requests, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.requestedBy == request.auth.uid || isAdmin());
      
      // Only admins can update (approve/reject)
      allow update: if isAdmin();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Event Edit Requests (for editing published events)
    match /event_edit_requests/{requestId} {
      // Users can create edit requests for their own events
      allow create: if isAuthenticated() && 
                       request.resource.data.requestedBy == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      // Users can read their own edit requests, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.requestedBy == request.auth.uid || isAdmin());
      
      // Only admins can update (approve/reject)
      allow update: if isAdmin();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Project Application Edit Requests
    match /project_application_edit_requests/{requestId} {
      // Users can create edit requests for their own applications
      allow create: if isAuthenticated() && 
                       request.resource.data.userEmail == request.auth.token.email &&
                       request.resource.data.status == 'pending';
      
      // Users can read their own edit requests, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userEmail == request.auth.token.email || isAdmin());
      
      // Only admins can update (approve/reject)
      allow update: if isAdmin() &&
                       (request.resource.data.status == 'approved' || 
                        request.resource.data.status == 'rejected');
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Event Registration Edit Requests
    match /event_registration_edit_requests/{requestId} {
      // Users can create edit requests for their own registrations
      allow create: if isAuthenticated() && 
                       request.resource.data.userEmail == request.auth.token.email &&
                       request.resource.data.status == 'pending';
      
      // Users can read their own edit requests, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.userEmail == request.auth.token.email || isAdmin());
      
      // Only admins can update (approve/reject)
      allow update: if isAdmin() &&
                       (request.resource.data.status == 'approved' || 
                        request.resource.data.status == 'rejected');
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // === PROJECT BOOKMARKS COLLECTION ===
    match /project_bookmarks/{bookmarkId} {
      // Users can read/update/delete their own bookmarks
      allow read, write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Users can create bookmarks for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // === PROJECT TASKS (TASK MANAGEMENT & CHECKLISTS) ===
    match /project_tasks/{taskId} {
      // Readers: task creator, assigned user, or admin
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdById ||
         request.auth.uid == resource.data.assignedToId ||
         isAdmin());
      // Any authenticated user can create tasks (typically NGO/admin/owners in UI)
      allow create: if isAuthenticated();
      // Updaters: creator, assigned user, or admin
      allow update, delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdById ||
         request.auth.uid == resource.data.assignedToId ||
         isAdmin());
    }

    // === TASK COMMENTS ===
    match /task_comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    // === MATCHING CACHE (VOLUNTEER MATCHING) ===
    match /matching_cache/{cacheId} {
      // Users can read/update/delete their own cached matches
      allow read, write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Users can create cache entries for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // === GAMIFICATION: POINTS, BADGES, ACHIEVEMENTS ===
    match /user_points/{entryId} {
      // Users can read their own point history; admins can read all
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      // Users can create entries for themselves (client-side awarding)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Only admins can update/delete history
      allow update, delete: if isAdmin();
    }

    match /user_points_stats/{userId} {
      // Leaderboards are public; anyone can read aggregate stats
      allow read: if true;
      // Users can create/update their own stats; admins can manage all
      allow create, update: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /user_badges/{badgeId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /user_achievements/{achId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // === REVIEWS & FEEDBACK ===
    match /reviews/{reviewId} {
      // Anyone can read reviews to build trust for projects/NGOs
      allow read: if true;

      // Authenticated users can create reviews in their own name
      allow create: if isAuthenticated() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      // Owners can update/delete their own reviews; admins can moderate all
      allow update, delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdById || isAdmin());
    }

    // === SOCIAL: LIKES, COMMENTS, FOLLOWS, COMMUNITY ===
    match /social_likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      // No updates; delete/recreate if needed
      allow update: if false;
    }

    match /social_comments/{commentId} {
      // Public read to encourage community
      allow read: if true;
      // Authenticated users can create comments in their own name
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Owners can edit/delete their own comments; admins can moderate all
      allow update, delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /user_follows/{followId} {
      // Followers can see their own relations; admins can see all; for now allow authenticated read
      allow read: if isAuthenticated();
      // Create follow relation where followerId is the current user
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid;
      // Unfollow: follower or admin can delete
      allow delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.followerId || isAdmin());
      // No updates
      allow update: if false;
    }

    // === SUBSCRIPTIONS & BILLING ===
    match /subscriptions/{userId} {
      // Users can read their own subscription data
      allow read: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
      // Users can create their own subscription (auto-initialized)
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.userId == userId;
      // Users can update their own subscription (plan changes)
      allow update: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
      // Only admins can delete subscriptions
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
